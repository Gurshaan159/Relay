{
  "manifest_version": 3,
  "name": "Relay recording session",
  "version": "1.0.0",
  "permissions": ["storage", "tabs", "webNavigation", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
